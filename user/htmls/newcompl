<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>New Complaint - Smart Complaint Management System</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link rel="stylesheet" href="../styles/styles.css">
</head>
<body>
    <nav class="sidebar">
        <!-- ... existing sidebar code ... -->
    </nav>

    <main class="main-content">
        <div class="header">
            <h1>Submit New Complaint</h1>
        </div>

        <div class="complaint-form-container">
            <form id="complaintForm" class="complaint-form">
                <div class="form-group">
                    <label for="complaintCategory">Category</label>
                    <select id="complaintCategory" required>
                        <option value="">Select a category</option>
                        <option value="Infrastructure">Infrastructure</option>
                        <option value="IT Support">IT Support</option>
                        <option value="Maintenance">Maintenance</option>
                        <option value="Security">Security</option>
                        <option value="Academics">Academics</option>
                        <option value="Other">Other</option>
                    </select>
                </div>

                <div class="form-group">
                    <label>Priority</label>
                    <div class="priority-tags">
                        <div class="priority-tag low" data-priority="Low">Low</div>
                        <div class="priority-tag medium" data-priority="Medium">Medium</div>
                        <div class="priority-tag high" data-priority="High">High</div>
                    </div>
                    <input type="hidden" id="priority" name="priority" required>
                </div>

                <div class="form-group">
                    <label for="complaintDescription">Description</label>
                    <textarea id="complaintDescription" rows="6" required 
                        placeholder="Please describe your complaint in detail..."></textarea>
                </div>

                <div class="form-actions">
                    <button type="submit" class="btn btn-primary">Submit Complaint</button>
                </div>
            </form>
        </div>
    </main>

    <script src="../scripts/newcomplaint.js"></script>
</body>
</html>